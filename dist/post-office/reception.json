 "hotspots": [
  {
   "id": "post-counter",
   "kind": "talk",
   "title": "Miss Maccalariat",
   "stand": [
    0.455,
    0.588
   ],
   "radius": 0.043,
   "text": "Letters and parcels to me, stamps to Mr Howler. Now then, Officer, what are you posting? And mind the counter pen.",
   "npc": "maccalariat"
  },
  {
   "id": "stamp-window",
   "kind": "talk",
   "title": "Stanley Howler",
   "stand": [
    0.627,
    0.585
   ],
   "radius": 0.043,
   "text": "Mind the perforations, please. A good stamp can make it all the way to Sto Lat. A good pin can too, but nobody's asked me to issue one.",
   "npc": "stanley"
  },
  {
   "id": "postal-supervision",
   "kind": "talk",
   "title": "Tolliver Groat",
   "npc": "groat",
   "stand": [
    0.335,
    0.577
   ],
   "radius": 0.036,
   "text": "If it’s registered, it goes in the book before it goes in the bag. That way, Officer, there’s a record of where to look if it fails to arrive."
  },
  {
   "id": "postal-postmaster",
   "kind": "talk",
   "title": "Moist von Lipwig",
   "npc": "moist",
   "stand": [
    0.535,
    0.574
   ],
   "radius": 0.037,
   "text": "An address, a stamp and a legible name. Get two of those right and we can usually sort out the third. Now, Officer, how can the Post Office help?"
  },
  {
   "id": "dispatch-notice",
   "kind": "examine",
   "title": "Dispatch notice",
   "stand": [
    0.232,
    0.584
   ],
   "radius": 0.046,
   "text": "Public enquiries and collections: main counter. Dispatch and deliveries: staff entrance."
  },
  {
   "id": "postal-motto",
   "kind": "examine",
   "title": "Exterior bronze motto",
   "stand": [
    0.501,
    0.854
   ],
   "radius": 0.038,
   "text": "Neither rain nor snow nor gloom of night can stay these messengers about their duty."
  }
 ],
